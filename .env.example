# Configuración de Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# Compatibilidad (deprecated)
SUPABASE_ANON_KEY=
# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Web client: se usa como serverClientId en Android y debe coincidir con el
# proveedor Google configurado en Supabase.
GOOGLE_WEB_CLIENT_ID=
# Android client: se registra con el package name y el SHA-1 del keystore.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
